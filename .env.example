# Firebase Configuration - EJEMPLO
# Reemplaza estos valores con los REALES de tu proyecto Firebase

# API Key (se encuentra en Project Settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=AIzaSyD1234567890abcdefghijklmnopqrstuvw

# Auth Domain (tu-proyecto.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=petworld-demo.firebaseapp.com

# Project ID (el ID de tu proyecto)
VITE_FIREBASE_PROJECT_ID=petworld-demo

# Storage Bucket (tu-proyecto.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=petworld-demo.appspot.com

# Messaging Sender ID (número)
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# App ID (se encuentra junto con la API Key)
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef